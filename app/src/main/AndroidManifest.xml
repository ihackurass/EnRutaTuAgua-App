<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Mapa híbrido online/offline (plan de precarga): detectar conectividad real. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ubicación (plan 09): el AAR de MapLibre ya los fusiona; se declaran por legibilidad. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Rastreo GPS en segundo plano (ANDROID-PLAN-04, RA-07). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EnRutaTuAguaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.EnRutaTuAgua">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EnRutaTuAgua.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ANDROID-PLAN-04: rastreo GPS del aguatero mientras hay ruta ABIERTA. -->
        <service
            android:name=".ubicacion.ServicioTrackingGps"
            android:foregroundServiceType="location"
            android:exported="false" />
    </application>

</manifest>
