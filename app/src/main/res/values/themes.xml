<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fondo de ventana = token `fondo` claro: sin flash blanco al arrancar. -->
    <style name="Theme.EnRutaTuAgua" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#EDF0F2</item>
    </style>

    <!-- Splash nativo (Android 12+ API, compat vía core-splashscreen): gota propia
         sobre `fondo`; cede el paso al tema real (postSplashScreenTheme). -->
    <style name="Theme.EnRutaTuAgua.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#EDF0F2</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_droplet</item>
        <item name="postSplashScreenTheme">@style/Theme.EnRutaTuAgua</item>
    </style>
</resources>
