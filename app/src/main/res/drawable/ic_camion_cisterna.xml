<?xml version="1.0" encoding="utf-8"?>
<!-- Camión cisterna cenital para el puck del LocationComponent (plan 09).
     REGLA DE ORO: el frente apunta HACIA ARRIBA (norte) — RenderMode.GPS rota
     este drawable con el bearing del fix (0° = norte). Un solo asset para
     claro/oscuro: la base blanca lo hace legible sobre ambos estilos de mapa.
     Colores fijos (un VectorDrawable no lee tokens Compose):
     tinta #0E1B2A · accion #0A7F90 · blanco. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="44dp"
    android:height="44dp"
    android:viewportWidth="44"
    android:viewportHeight="44">

    <!-- Base: disco blanco con aro tinta al 10% -->
    <path
        android:pathData="M22,2 a20,20 0 1,1 -0.01,0 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#1A0E1B2A"
        android:strokeWidth="1.5" />

    <!-- Chevron de rumbo (asoma sobre la cabina, punta en y=4) -->
    <path
        android:pathData="M22,4 L26.5,9.5 L17.5,9.5 Z"
        android:fillColor="#0A7F90" />

    <!-- Cabina -->
    <path
        android:pathData="M15,10 a3,3 0 0,1 3,-3 h8 a3,3 0 0,1 3,3 v5 h-14 Z"
        android:fillColor="#0E1B2A" />

    <!-- Parabrisas -->
    <path
        android:pathData="M17,9 h10 v3 h-10 Z"
        android:fillColor="#0A7F90" />

    <!-- Tanque (cápsula) -->
    <path
        android:pathData="M14,24 a8,8 0 0,1 16,0 v4 a8,8 0 0,1 -16,0 Z"
        android:fillColor="#0E1B2A" />

    <!-- Tapa de inspección de la cisterna -->
    <path
        android:pathData="M22,22 a4,4 0 1,1 -0.01,0 Z"
        android:fillColor="#0A7F90"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1" />
</vector>
